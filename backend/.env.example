# Conexão com o PostgreSQL (o docker-compose.yml da raiz já sobe um com estes dados, na porta 5433)
DATABASE_URL=postgres://reserva:reserva@localhost:5433/reserva_upe

PORT=3001
# Troque por uma string longa e aleatória em produção
JWT_SECRET=troque-esta-chave-em-producao

# --- Login Google (RF01). Deixe GOOGLE_CLIENT_ID vazio para usar só o login de desenvolvimento ---
GOOGLE_CLIENT_ID=
# Domínios de e-mail aceitos, separados por vírgula
ALLOWED_DOMAINS=upe.br
# Exceções: e-mails de fora do domínio acima que também podem entrar (contas de teste). Edite e salve: vale na hora.
# AUTHORIZED_EMAILS_FILE=emails-autorizados.txt
# E-mails que ganham o papel ADMIN no primeiro login, separados por vírgula
ADMIN_EMAILS=edson.ofreitas@upe.br

# Login de desenvolvimento (escolhe um usuário de teste, sem Google). NUNCA ativar em produção.
DEV_LOGIN=true
